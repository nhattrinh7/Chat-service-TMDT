generator client {
  provider = "prisma-client-js"
}

// prisma tự động đọc file .env dù cho chưa cài .dotenv, nhưng chỉ đọc được giá trị 
// trong env khi prisma đã start lên, những chỗ chưa start thì chịu
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

enum SenderType {
  USER
  SHOP
}

enum MessageType {
  TEXT
  IMAGE
}

model Conversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid // Reference to User Service - người mua hàng
  shopId String @map("shop_id") @db.Uuid // Reference to Shop Service

  // Denormalized last message info for performance (cập nhật mỗi khi có tin nhắn mới)
  lastMessageId         String?     @map("last_message_id") @db.Uuid
  lastMessageContent    String?     @map("last_message_content")
  lastMessageType       MessageType? @map("last_message_type")
  lastMessageAt         DateTime?   @map("last_message_at") @db.Timestamptz
  lastMessageSenderId   String?     @map("last_message_sender_id") @db.Uuid
  lastMessageSenderType SenderType? @map("last_message_sender_type")

  // Đếm tin nhắn chưa đọc cho từng bên
  unreadCountUser Int @default(0) @map("unread_count_user")
  unreadCountShop Int @default(0) @map("unread_count_shop")

  // ID tin nhắn cuối mà mỗi bên đã đọc
  lastReadMessageIdUser String? @map("last_read_message_id_user") @db.Uuid
  lastReadMessageIdShop String? @map("last_read_message_id_shop") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  messages Message[]

  @@unique([userId, shopId]) // 1 cặp user-shop chỉ có 1 conversation
  @@index([userId, updatedAt(sort: Desc)]) // User list conversations, sắp xếp theo tin nhắn mới nhất
  @@index([shopId, updatedAt(sort: Desc)]) // Shop list conversations, sắp xếp theo tin nhắn mới nhất

  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid // userId hoặc shopId tùy theo senderType
  senderType     SenderType  @map("sender_type")
  messageType    MessageType @default(TEXT) @map("message_type")
  message        String?     // Text content hoặc image URL

  // Reply - denormalized để tránh N+1 queries
  replyToMessageId      String?     @map("reply_to_message_id") @db.Uuid
  replyToMessageContent String?     @map("reply_to_message_content") // Nội dung tin nhắn gốc tại thời điểm reply
  replyToSenderType     SenderType? @map("reply_to_sender_type") // Người gửi tin nhắn gốc

  // Soft delete
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz // null = chưa xóa, có giá trị = đã xóa

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  replyToMessage Message?     @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies        Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt(sort: Desc)]) // Load messages cursor-based pagination
  @@index([conversationId, deletedAt]) // Filter soft-deleted messages

  @@map("messages")
}
 